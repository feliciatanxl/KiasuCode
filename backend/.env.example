PORT=3000
NODE_ENV=development

# Local URLs used during development.
LOCAL_BACKEND_URL=http://localhost:3000
LOCAL_FRONTEND_URL=http://localhost:5173

# Railway URLs used when NODE_ENV=production.
BACKEND_URL=https://your-backend.up.railway.app
# Comma-separated, exact frontend origins allowed to send credentialed requests.
FRONTEND_URL=https://your-frontend.up.railway.app

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=replace_with_your_database_password
DB_NAME=kiasucode

# OAuth client ID used by the frontend Google Login button.
GOOGLE_CLIENT_ID=replace_with_your_google_client_id

# Use a long, random value in production.
JWT_SECRET=replace_with_a_long_random_session_secret

# Public Telegram Login client ID from BotFather. If omitted, the numeric bot ID
# from TELEGRAM_BOT_TOKEN is used.
TELEGRAM_CLIENT_ID=replace_with_your_telegram_client_id

# Server-only secret retained for legacy signed Telegram payload verification.
# Set the real value only in the backend runtime; never commit it.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
