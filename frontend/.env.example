VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Public username only. Never put the Telegram bot token in a VITE_* variable.
VITE_TELEGRAM_BOT_NAME=your_bot_username
VITE_AUTH_API_URL=http://localhost:3001

# Optional development tunnel hostname, without https:// or a path.
DEV_ALLOWED_HOST=your-assigned-name.ngrok-free.dev
